<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceGit.Converters"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.Welcome"
             x:DataType="vm:Welcome">
  <Grid RowDefinitions="Auto,*" Margin="24,18,24,16">
    <!-- Home hero: real workspace data, not a static dashboard. -->
    <Border Grid.Row="0" Background="{DynamicResource Brush.SubPanel}"
            CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border2}"
            Padding="24,18">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="7">
          <TextBlock Text="MYGIT  /  WORKSPACE" Foreground="{DynamicResource Brush.Accent}" FontSize="11" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ActiveWorkspace.Name}" FontSize="25" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding ManagedRepositoryCount}" Foreground="{DynamicResource Brush.FG2}" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Text.PageTabBar.Welcome.Title}" Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Text="·" Foreground="{DynamicResource Brush.FG2}"/>
            <TextBlock Text="{Binding WorkspaceCount}" Foreground="{DynamicResource Brush.FG2}" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Text.Launcher.Workspaces}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Width="54" Height="54" CornerRadius="16"
                Background="{DynamicResource Brush.Mygit.Selected}" VerticalAlignment="Center">
          <Path Data="{StaticResource Icons.Repositories}" Width="24" Height="24"
                Fill="{DynamicResource Brush.Accent}"/>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="0,16,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="170"/>
      <ColumnDefinition Width="*" MinWidth="480"/>
      <ColumnDefinition Width="210"/>
    </Grid.ColumnDefinitions>

    <!-- Stable left navigation; workspace/repository switching is also available in the title bar. -->
    <Border Grid.Row="0" Grid.Column="0" Margin="0,0,16,0" Padding="14,20"
            Background="{DynamicResource Brush.SubPanel}" CornerRadius="12">
      <StackPanel Spacing="12">
        <TextBlock Text="{DynamicResource Text.Launcher.Workspaces}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}"/>
        <TextBlock Text="{Binding ActiveWorkspace.Name}" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
        <Border Height="1" Margin="0,8" Background="{DynamicResource Brush.Border2}"/>
        <TextBlock Text="{DynamicResource Text.PageTabBar.Welcome.Title}"
                   Classes="mygit_section_label" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding ManagedRepositoryCount}" FontSize="27" FontWeight="Bold"/>
        <Border Height="1" Margin="0,6" Background="{DynamicResource Brush.Mygit.Hairline}"/>
        <TextBlock Text="{DynamicResource Text.Welcome.DragDropTip}"
                   Classes="mygit_section_label" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Read-only counts obtained from the existing repository/workspace model. -->
    <Border Grid.Row="0" Grid.Column="2" Margin="16,0,0,0" Padding="16,20"
            Background="{DynamicResource Brush.SubPanel}" CornerRadius="12">
      <StackPanel Spacing="12">
        <TextBlock Text="OVERVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.FG2}"/>
        <TextBlock Text="{Binding ManagedRepositoryCount}" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="{DynamicResource Text.PageTabBar.Welcome.Title}" Foreground="{DynamicResource Brush.FG2}"/>
        <Border Height="1" Margin="0,8" Background="{DynamicResource Brush.Border2}"/>
        <TextBlock Text="{Binding WorkspaceCount}" FontSize="27" FontWeight="Bold"/>
        <TextBlock Text="{DynamicResource Text.Launcher.Workspaces}" Foreground="{DynamicResource Brush.FG2}"/>
      </StackPanel>
    </Border>

    <!-- Managed Repositories -->
    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">
      <!-- Search Box -->
      <TextBox Grid.Row="0"
               x:Name="SearchBox"
               Height="32"
               Padding="0"
               CornerRadius="16"
               BorderBrush="{DynamicResource Brush.Border0}"
               BorderThickness="1"
               Background="{DynamicResource Brush.Contents}"
               Watermark="{DynamicResource Text.Welcome.Search}"
               VerticalContentAlignment="Center"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.Styles>
          <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
          </Style>
          <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
          </Style>
        </TextBox.Styles>

        <TextBox.InnerLeftContent>
          <Path Width="16" Height="16" Margin="6,0,3,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal">
            <!-- Invisible Button to handle search hotkey pressed-->
            <Button Width="0" Height="0"
                    Margin="0" Padding="0"
                    Click="OnSearchHotKey"
                    HotKey="{OnPlatform Ctrl+F, macOS=⌘+F}"/>

            <Button Classes="icon_button" IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnClearSearchFilter">
              <Path Width="16" Height="16" Margin="0,0,0,0" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG1}"/>
            </Button>
          </StackPanel>
        </TextBox.InnerRightContent>
      </TextBox>

      <!-- Primary actions match the original home design and reuse SourceGit commands. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,12,8,0">
        <Button Grid.Column="0" Classes="flat" Height="88" CornerRadius="12"
                Background="{DynamicResource Brush.Mygit.Card}"
                Click="OnCloneRepository" BorderBrush="{DynamicResource Brush.Mygit.Hairline}">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icons.Clone}" Width="22" Height="22"
                  Fill="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{DynamicResource Text.Welcome.Clone}" HorizontalAlignment="Center"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="flat" Height="88" CornerRadius="12"
                Background="{DynamicResource Brush.Mygit.Card}"
                Click="OnOpenLocalRepository" BorderBrush="{DynamicResource Brush.Mygit.Hairline}">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icons.Folder.Open}" Width="22" Height="22"
                  Fill="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{DynamicResource Text.Welcome.OpenOrInit}" HorizontalAlignment="Center"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="flat" Height="88" CornerRadius="12"
                Background="{DynamicResource Brush.Mygit.Card}"
                Command="{Binding AddRootNode}" BorderBrush="{DynamicResource Brush.Mygit.Hairline}">
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Path Data="{StaticResource Icons.Folder.Add}" Width="22" Height="22"
                  Fill="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="{DynamicResource Text.Welcome.AddRootFolder}" HorizontalAlignment="Center"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Button>
      </Grid>

      <!-- Most recently used repositories; same validated open action as the tree. -->
      <StackPanel Grid.Row="2" Margin="0,14,0,10" Spacing="9">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{DynamicResource Text.QuickRepo.Recent}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{DynamicResource Text.PageTabBar.Welcome.Title}"
                     Classes="mygit_section_label"/>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Height="126">
          <ItemsControl ItemsSource="{Binding RecentRepositories, Mode=OneWay}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:RepositoryNode">
              <Border Classes="mygit_card"
                      Width="206" Margin="0,0,10,10"
                      Tapped="OnRecentRepositoryTapped"
                      ToolTip.Tip="{Binding Id}">
                <StackPanel Spacing="9">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Border Width="32" Height="32" CornerRadius="9"
                            Background="{DynamicResource Brush.Mygit.Selected}">
                      <Path Width="16" Height="16"
                            Data="{StaticResource Icons.Repositories}"
                            Fill="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               FontSize="14" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <TextBlock Text="{Binding Id}" FontSize="11"
                             Foreground="{DynamicResource Brush.Mygit.Muted}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- Repository Tree -->
      <v:RepositoryListBox Grid.Row="3"
                           x:Name="TreeContainer"
                           Margin="0,12,8,0"
                           Focusable="True"
                           Background="Transparent"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ItemsSource="{Binding Rows}"
                           SelectionMode="Single"
                           LostFocus="OnTreeViewLostFocus"
                           DragDrop.AllowDrop="True"
                           DragDrop.DragOver="DragOverTreeView"
                           DragDrop.Drop="DropOnTreeView">
        <ListBox.Styles>
          <Style Selector="ListBox">
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>

          <Style Selector="ListBoxItem" x:DataType="vm:RepositoryNode">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="{DynamicResource Text.Welcome.AddRootFolder}" Command="{Binding AddRootNode}">
              <MenuItem.Icon>
                <Path Width="12" Height="12" Data="{DynamicResource Icons.Folder.Add}"/>
              </MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </ListBox.ContextMenu>

        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:RepositoryNode">
            <Grid Background="Transparent"
                  Height="36"
                  ColumnDefinitions="16,18,*,Auto,8"
                  Margin="{Binding Depth, Converter={x:Static c:IntConverters.ToTreeMargin}}"
                  ClipToBounds="True"
                  ContextRequested="OnTreeNodeContextRequested"
                  PointerPressed="OnPointerPressedTreeNode"
                  PointerMoved="OnPointerMovedOverTreeNode"
                  PointerReleased="OnPointerReleasedOnTreeNode"
                  DoubleTapped="OnDoubleTappedTreeNode"
                  DragDrop.AllowDrop="True"
                  DragDrop.DragOver="DragOverTreeNode"
                  DragDrop.Drop="DropOnTreeNode">
              <v:RepositoryTreeNodeToggleButton Grid.Column="0"
                                                Classes="tree_expander"
                                                Focusable="False"
                                                HorizontalAlignment="Center"
                                                IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                                IsVisible="{Binding !IsRepository}"/>

              <v:Bookmark Grid.Column="1"
                          Width="14" Height="14"
                          HorizontalAlignment="Center"
                          Value="{Binding Bookmark, Mode=OneWay}"
                          IsVisible="{Binding IsRepository}"/>

              <ToggleButton Grid.Column="1"
                            Classes="folder"
                            Focusable="False"
                            Width="14" Height="14"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource Brush.FG1}"
                            IsChecked="{Binding IsExpanded}"
                            IsVisible="{Binding !IsRepository}"/>

              <StackPanel Grid.Column="2" Orientation="Horizontal" ClipToBounds="True">
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Id, StringFormat=({0}), Converter={x:Static c:PathConverters.RelativeToHome}}">
                  <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                      <Binding Path="IsRepository"/>
                      <Binding Path="IsInvalid" Converter="{x:Static BoolConverters.Not}"/>
                    </MultiBinding>
                  </TextBlock.IsVisible>
                </TextBlock>
                <Path Margin="2,0,0,0"
                      Width="12" Height="12"
                      Data="{StaticResource Icons.Error}"
                      Fill="Orange"
                      IsVisible="{Binding IsInvalid}"/>
              </StackPanel>

              <ContentControl Grid.Column="3"
                              Margin="6,0,0,0"
                              Content="{Binding Status, Mode=OneWay}"
                              IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentControl.DataTemplates>
                  <DataTemplate DataType="m:RepositoryStatus">
                    <StackPanel Orientation="Horizontal">
                      <Border Margin="3,0"
                              Height="18"
                              CornerRadius="9"
                              Padding="6,0"
                              Background="{DynamicResource Brush.FG1}"
                              VerticalAlignment="Center"
                              IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                        <TextBlock Text="{Binding LocalChanges}"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   FontSize="11"
                                   Foreground="{DynamicResource Brush.Window}"/>
                      </Border>

                      <TextBlock Margin="3,0"
                                 Text="{Binding TrackingDescription}"
                                 FontFamily="{DynamicResource Fonts.Monospace}"
                                 FontSize="12"
                                 IsVisible="{Binding IsTrackingStatusVisible}"/>

                      <Border Margin="3,0,0,0"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource Brush.FG2}"
                              Height="20"
                              CornerRadius="4"
                              Padding="4,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}"/>
                          <TextBlock Margin="2,0,0,0" Text="{Binding CurrentBranch}" FontSize="12"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </v:RepositoryListBox>
    </Grid>

    <!-- Tips -->
    <Border Grid.Row="1" Grid.Column="1"
            Margin="0,8,0,0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            IsVisible="{OnPlatform True, Linux=False}">
      <TextBlock Classes="italic"
                 FontSize="12"
                 Text="{DynamicResource Text.Welcome.DragDropTip}"
                 Opacity=".5"/>
    </Border>
    </Grid>
  </Grid>
</UserControl>
